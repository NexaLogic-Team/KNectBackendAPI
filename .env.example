ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Host=your-neon-host.db.neon.tech;Database=neondb;Username=neondb_owner;Password=replace-with-real-password;Port=5432;SSL Mode=Require;Trust Server Certificate=false;
Jwt__Issuer=https://api.example.com
Jwt__Audience=knect-api
Jwt__Key=replace-with-a-long-random-secret-key
Jwt__AccessTokenLifetimeMinutes=15
Jwt__RefreshTokenLifetimeDays=14
Google__ClientId=replace-me
Google__ClientSecret=replace-me
Email__Provider=SendGrid
Email__Host=smtp.sendgrid.net
Email__Port=587
Email__EnableSsl=true
Email__From=noreply@example.com
Email__Username=apikey
Email__Password=replace-me
S3__BucketName=knect-prod
S3__Region=ap-southeast-1
S3__AccessKey=replace-me
S3__SecretKey=replace-me
S3__ServiceUrl=https://s3.ap-southeast-1.amazonaws.com
S3__ForcePathStyle=false
BackgroundJobs__SubscriptionLifecycle__Enabled=true
BackgroundJobs__SubscriptionLifecycle__CheckIntervalMinutes=5
BackgroundJobs__SubscriptionLifecycle__BatchSize=200
BackgroundJobs__SubscriptionLifecycle__ExpiryReminderDays=7
BackgroundJobs__SubscriptionLifecycle__FinalReminderDays=1
BackgroundJobs__SubscriptionLifecycle__MaxRetryAttempts=3
Cors__AllowedOrigins=https://app.example.com,https://admin.example.com
Frontend__BaseUrl=https://app.example.com
